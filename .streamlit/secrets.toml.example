# Copy this file to secrets.toml and fill in real values for local dev
# Configure the same keys in Streamlit Community Cloud under App > Settings > Secrets

# App-level password gate (leave blank or omit to disable)
APP_PASSWORD = "your_app_password_here"

HOL_PASSWORD = "your_hol_password_here"
HOL_TEMP_PASSWORD = "your_hol_temp_password_here"
GITLAB_API_TOKEN = "your_gitlab_api_token_here"

# Key-pair auth (default mode)
# Option A: Inline PEM content (recommended for Streamlit Cloud — paste full key here)
# PRIVATE_KEY_PEM = """
# -----BEGIN PRIVATE KEY-----
# MIIJQwIBADA...
# -----END PRIVATE KEY-----
# """
# Option B: Local file path (for local development when PRIVATE_KEY_PEM is not set)
PRIVATE_KEY_PATH = "~/SI_ACCOUNTS_PEM_KEY/priv_key.pem"
SERVICE_USER = "EMERGENCY_SERVICE_USER"
